{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "HackerNewsApi": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "BestStoriesEndpoint": "beststories.json",
    "ItemEndpoint": "item/{0}.json",
    "Fallback": "https://news.ycombinator.com/item?id={0}"
  },

  "AllowedHosts": "*"
}